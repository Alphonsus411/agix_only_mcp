diff --git a/src/agix/qualia/emotional_rnn.py b/src/agix/qualia/emotional_rnn.py
index 28be4f5..6d11cc6 100644
--- a/src/agix/qualia/emotional_rnn.py
+++ b/src/agix/qualia/emotional_rnn.py
@@ -51,6 +51,33 @@ class EmotionalRNN:
         if self.rnn_type == "lstm":
             self.c = np.zeros(self.hidden_size)
 
+    # ------------------------------------------------------------------
+    def expand_inputs(self, extra: int) -> None:
+        """Añade ``extra`` dimensiones de entrada/salida conservando lo aprendido.
+
+        Las nuevas entradas empiezan con pesos nulos (no alteran el estado oculto)
+        y las nuevas salidas con pesos pequeños aleatorios.
+        """
+        if extra <= 0:
+            return
+        rng = np.random.default_rng(42 + self.input_size)
+        old_in = self.input_size
+        self.input_size += extra
+        self.output_size = self.input_size
+        if self.rnn_type == "rnn":
+            self.Wxh = np.hstack([self.Wxh, np.zeros((self.hidden_size, extra))])
+        else:
+            # En LSTM las columnas de entrada van antes que las del estado oculto
+            for name in ("Wf", "Wi", "Wc", "Wo"):
+                w = getattr(self, name)
+                setattr(
+                    self,
+                    name,
+                    np.hstack([w[:, :old_in], np.zeros((w.shape[0], extra)), w[:, old_in:]]),
+                )
+        self.Why = np.vstack([self.Why, rng.normal(0, 0.1, (extra, self.hidden_size))])
+        self.by = np.concatenate([self.by, np.zeros(extra)])
+
     # ------------------------------------------------------------------
     def _sigmoid(self, x: np.ndarray) -> np.ndarray:
         return 1 / (1 + np.exp(-x))
